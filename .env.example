# ── Server ───────────────────────────────────────────────────────────────────
# Porta locale (su Railway viene impostata automaticamente)
PORT=3003

# Base URL pubblica dei modelli 3D pesanti.
# LOCALE: lascia VUOTO → il viewer usa la cartella viewer/models.
# PRODUZIONE (Railway): URL pubblico R2 + prefisso progetto, es:
#   https://pub-xxxxxxxx.r2.dev/spatial32
ASSET_BASE=

# ── Cloudflare R2 — servono SOLO per lo script di upload (npm run upload) ──────
# NON serve impostarle su Railway (il server non le usa).
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=immersivelab-assets
R2_PREFIX=spatial32
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
