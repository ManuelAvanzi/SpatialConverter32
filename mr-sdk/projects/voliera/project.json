{
  "name": "Voliera Demo",
  "version": "1.0.0",
  "sdkVersion": "1.0.0",
  "entry": "entry.js",
  "type": "custom",
  "assets": { "models": [] },
  "capabilities": ["scene", "update", "interactables", "colliders", "entrances", "avatarRead"],
